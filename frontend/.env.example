# Template for frontend/.env — the SINGLE configuration file. Copy and fill in:
#
#     cp .env.example .env
#
# PRECEDENCE, highest first:
#
#   1. dist/config.js -> window.__APP_CONFIG__   (RUNTIME, per deployment)
#   2. frontend/.env                              (BUILD -- Vite inlines it)
#   3. '' -> relative paths, same origin as the page
#
# Vite INLINES these into the bundle at build time, so they are baked into a
# built artifact. To repoint a bundle WITHOUT rebuilding, edit dist/config.js
# instead -- it is read at runtime and wins over everything here. That is why
# one file is enough: deployments differ through config.js, not through a
# second .env. See src/config/env.js and public/config.js.
#
# Only APPLICATION_-prefixed variables reach the client.

# Complete backend base URL, INCLUDING the service prefix and /api/. Every
# path in src/api/endpoints.js is relative to this -- nothing appends a
# further prefix or path. Empty => relative paths, same origin as the page,
# which is right when the SPA is served by the API's own host.
APPLICATION_API_BASE_URL=http://127.0.0.1:8000/api/

# Vite dev server port. The backend's FRONTEND_ORIGINS must list this origin
# or the browser blocks every call.
APPLICATION_DEV_PORT=5173

# Login/register/OTP go DIRECTLY to ELEVATE's user service from the browser --
# never proxied through Saarthi's own backend (Saarthi only ever VALIDATES the
# JWT this produces; see backend's ELEVATE_JWT_SECRET). credential_env-style:
# this names where to log in, it holds no secret.
APPLICATION_ELEVATE_BASE_URL=https://qa.elevate-apis.shikshalokam.org
APPLICATION_ELEVATE_TENANT_ID=saarthi

# Which login modes LoginPage shows -- comma-separated, "password", "otp", or
# both. This is only the STATIC default: ELEVATE's own branding response
# (configuration.allowed_auth_mode) overrides it once loaded, for whichever
# tenant is actually configured. Unset or unrecognised -> both.
APPLICATION_AUTH_MODES=password,otp

# Whether the profile form POPS UP after login when mandatory fields (name,
# role, school, district, state) are missing. DEFAULT ON -- unset or any value
# other than false/0/off/no leaves it enabled.
#
# Turning it off does NOT remove the feature: the sidebar's Profile section and
# its Update button are unaffected, so updating becomes voluntary rather than
# impossible. Whether the feature works AT ALL is the backend's
# ELEVATE_BASE_URL -- unset there, /api/profile answers 503 and the Profile
# section hides itself whatever this says.
APPLICATION_PROFILE_POPUP_ENABLED=true
