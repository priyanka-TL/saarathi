# Template for frontend/.env — the SINGLE configuration file. Copy and fill in:
#
#     cp .env.example .env
#
# PRECEDENCE, highest first:
#
#   1. dist/config.js -> window.__APP_CONFIG__   (RUNTIME, per deployment)
#   2. frontend/.env                              (BUILD -- Vite inlines it)
#   3. '' -> relative paths, same origin as the page
#
# Vite INLINES these into the bundle at build time, so they are baked into a
# built artifact. To repoint a bundle WITHOUT rebuilding, edit dist/config.js
# instead -- it is read at runtime and wins over everything here. That is why
# one file is enough: deployments differ through config.js, not through a
# second .env. See src/config/env.js and public/config.js.
#
# Only APPLICATION_-prefixed variables reach the client.

# Complete backend base URL, INCLUDING the service prefix and /api/. Every
# path in src/api/endpoints.js is relative to this -- nothing appends a
# further prefix or path. Empty => relative paths, same origin as the page,
# which is right when the SPA is served by the API's own host.
APPLICATION_API_BASE_URL=http://127.0.0.1:8000/api/

# Vite dev server port. The backend's FRONTEND_ORIGINS must list this origin
# or the browser blocks every call.
APPLICATION_DEV_PORT=5173
