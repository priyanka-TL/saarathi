# Template for backend/.env — the SINGLE configuration file. Copy and fill in:
#
#     cp .env.example .env
#
# .env is git-ignored, because it holds the secrets (OPENROUTER_API_KEY,
# SAARTHI_STATIC_TOKEN, DATABASE_URL, MITRA_ORIGIN_URL) alongside everything
# else. There is deliberately no second file and no per-environment file: a
# deployment differs by the VALUES below, or by injecting real environment
# variables, which outrank this file entirely.
#
# PRECEDENCE, highest first:
#
#   1. real environment variables
#        APP_ENV=qa PORT=9000 API_PREFIX=/saarathi-service make run
#   2. backend/.env
#   3. the field defaults in app/core/settings.py
#
# The path is resolved against the backend/ directory, not the CWD, so the same
# config is found whatever directory you launch from.
#
# Every key below is a real field on Settings. extra="ignore" means a key that
# is NOT a field is silently accepted and silently does nothing, so add the
# field to app/core/settings.py first. (The Flask .env.example had accumulated
# ~12 such keys: SAARTHI_PERSISTENCE, SAARTHI_ROUTER, SAARTHI_USER_TOKEN, ...)
#
# Do NOT put an inline `# comment` after a value unless you mean it: the value
# is everything up to the comment, trailing spaces trimmed. Put comments on
# their own line, as below.

# ---- environment ---------------------------------------------------------
# A label only; it selects nothing. Echoed in the startup log so a running
# process can say which deployment it believes it is.
# development | qa | production
APP_ENV=development

# ---- server --------------------------------------------------------------
# 0.0.0.0 in a container, 127.0.0.1 locally.
HOST=127.0.0.1
PORT=8000
# MUST stay 1 while MITRA_ENABLED=1: MitraSessionManager pools live WebSockets
# in process memory, so a second worker opens a second Mitra channel for the
# same interview. assert_single_worker enforces it. Scale with THREADPOOL_SIZE.
WORKERS=1
# Mounted in front of EVERY route, including /healthz and /docs.
#   (empty)             -> POST /api/chat
#   /saarathi-service   -> POST /saarathi-service/api/chat
# The app serves this itself, so a proxy must FORWARD the prefix, not strip it.
API_PREFIX=

# ---- core ----------------------------------------------------------------
LOG_LEVEL=INFO
# REQUIRED. Missing => sys.exit(1) at import.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ---- database ------------------------------------------------------------
# Deliberately a DIFFERENT database from the Flask app's, so both can run side
# by side and neither app fights the other over the agents / agent_configs
# tables.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/saarthi_new
DB_POOL_SIZE=16
DB_MAX_OVERFLOW=8
# One request == one worker thread == one DB connection for the whole turn, so
# this MUST stay <= DB_POOL_SIZE or overload becomes QueuePool timeouts
# surfaced to the client as 500 INTERNAL. Unset => DB_POOL_SIZE.
# THREADPOOL_SIZE=16

# ---- web tier ------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Must include the
# SPA's origin (frontend/.env -> APPLICATION_DEV_PORT) or every request is
# blocked by CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- registry ------------------------------------------------------------
# THE DATABASE IS THE ONLY SOURCE for agent config: `agents` + `agent_configs`
# are what AgentRegistry reads and what the config API writes, scoped per
# tenant and organization. There is no YAML and no CONFIG_SYNC_MODE -- the
# catalogue is seeded by migration 0007, so `make migrate` is all a fresh
# database needs.
#
# This is also the upper bound on how long a config change takes to go live:
# the in-process snapshot re-checks MAX(updated_at) at most this often. No
# restart, nothing to redeploy.
REGISTRY_TTL_S=30

# ---- identity — AUTH_CHECK is the only switch ----------------------------
# IDENTITY IS RESOLVED ONCE, HERE, FROM THIS FILE -- not per request, not from
# the caller's `Authorization` header. The frontend is a bare SPA with no
# login flow and nothing that could supply a real per-caller JWT, so there is
# no request-borne identity to read; every request served by this process gets
# the SAME UserContext, decided at container build time.
#
# true  => decode SAARTHI_STATIC_TOKEN below. The token IS the identity:
#          user_id, display_name, tenant_code, organizations, roles and the
#          email are all DERIVED from its claims.
# false => no token is read; every request serves the hardcoded development
#          identity in app/services/identity.py. NEVER false in production.
#
# Saarthi is the SOLE validator. This app never verifies the signature or the
# expiry -- doing so could only reject a request Saarthi already accepted.
# That is why there is no JWT secret setting; adding one back means adding the
# field to Settings first (extra="ignore" would silently swallow it).
#
# TENANT-SCOPED CONFIGURATION STILL EXISTS at the schema and admin-API level:
# `/api/admin/capabilities` takes `tenant_id`/`organization_id` as explicit
# parameters, not derived from the caller's own identity, so per-tenant rows
# remain fully writable and readable. What does not exist is an ordinary
# end-user request resolving to more than one tenant -- there is currently
# nothing that could assert who a browser's user is.
AUTH_CHECK=true
# The Saarthi-issued JWT -- the identity EVERY request resolves to while
# AUTH_CHECK=true. Required while AUTH_CHECK=true. Decoded once at startup, so
# a malformed token is a boot failure, not a runtime one -- it cannot reach a
# user.
SAARTHI_STATIC_TOKEN=

# ---- email derivation — MUST match Mitra's SSO path exactly --------------
# Mitra derives: email = data[JWT_IDENTIFIER_FIELD] + JWT_EMAIL_SUFFIX
# Mitra's own default identifier field is 'userId', which this token does NOT
# carry — the field is 'id'. Getting this wrong creates a SECOND Mitra profile
# for the same person and splits their stories across two identities.
JWT_IDENTIFIER_FIELD=id
JWT_EMAIL_SUFFIX=@shikshalokam.org

# ---- feature flags -------------------------------------------------------
# 0 => the whole /api/agents admin surface 404s
SAARTHI_ADMIN_ENABLED=0
# 0 disables all remote_flow agents
MITRA_ENABLED=0

# ---- mitra relay ---------------------------------------------------------
MITRA_BASE_URL=https://<mitra-host>
MITRA_WS_URL=wss://<mitra-host>/ws/common/
# Mitra gates admission on the Origin header — treat this as a CREDENTIAL.
# Never log it, never store it in a config row, never echo it in an error
# response. A scope needing its OWN origin names a variable via
# `remote.origin_env` in its agent config; the value stays here.
MITRA_ORIGIN_URL=https://<allowlisted-origin>
# Leave MITRA_USER_AGENT unset to keep the Settings default (a full browser UA
# string). An EMPTY value here would override it with "".
# MITRA_USER_AGENT=
# Comma-separated EXTRA hosts get_report() may return presigned URLs on. The
# MITRA_BASE_URL host is trusted implicitly; the report CDN/static host usually
# is NOT the same host, and omitting it fails _validate_url on every report.
MITRA_ALLOWED_HOSTS=<report-static-host>
MITRA_CONNECT_TIMEOUT_S=10
MITRA_READ_TIMEOUT_S=30
MITRA_WS_CONNECT_TIMEOUT_S=10
MITRA_IP_CITY=Bengaluru
MITRA_IP_STATE=Karnataka
MITRA_IP_ZIP=562130
MITRA_MAX_OPEN_CHANNELS=200
MITRA_IDLE_CLOSE_S=1200

# Mitra's OWN endpoint paths. A third-party API contract, not a preference —
# change only when Mitra moves an endpoint. The v1/v2 finalize pair is
# load-bearing: the two read the user token from different places (v2 header,
# v1 body) and select different PDF renderers, so POST /api/agents/{key}/config
# asserts every config's finalize_path matches one of them.
#
# These are the DEFAULT values; a scope may override them through
# `remote.connection.paths` in its agent config.
MITRA_PROFILE_PATH=/api/profile/
MITRA_GENERATE_SESSION_PATH=/api/generate-session/
MITRA_CHAT_PATH=/api/companychat/
MITRA_GET_STORY_PATH=/api/get-story/
MITRA_FINALIZE_V1_PATH=/api/end-story/
MITRA_FINALIZE_V2_PATH=/api/end-story/v2/

# ---- NOT HERE ANY MORE ---------------------------------------------------
# MITRA_COMPANY, MITRA_STORY_BOT_ROUTE and MITRA_DISCUSSION_BOT_ROUTE are gone.
# Nothing reads them. Their values live in `remote.company` / `remote.bot_route`
# on the stored agent config, seeded by migration 0007 -- which is what lets a
# TENANT override them:
#
#   POST /api/agents/record_stories/config?tenant_id=...&organization_id=...
#
# Mitra identifies a profile by (email, company), so that is the difference
# between every tenant sharing one Mitra company and each having its own.
# See docs/configuration.md.

# ---- SSRF backstop on a config-supplied allowlist ------------------------
# A tenant's agent config may override `remote.connection.allowed_hosts`, which
# is what MitraRestClient._validate_url checks presigned report URLs against.
# When this is set, any config-supplied host outside it is dropped.
#
# EMPTY MEANS NO CEILING — the default, so existing deployments are unchanged.
# Set it to every host any tenant may legitimately be pointed at.
# MITRA_HOST_CEILING=qa-mohini-static.shikshalokam.org
