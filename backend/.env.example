# Template for backend/.env — the SINGLE configuration file. Copy and fill in:
#
#     cp .env.example .env
#
# .env is git-ignored, because it holds the secrets (OPENROUTER_API_KEY,
# SAARTHI_STATIC_TOKEN, DATABASE_URL, MITRA_ORIGIN_URL) alongside everything
# else. There is deliberately no second file and no per-environment file: a
# deployment differs by the VALUES below, or by injecting real environment
# variables, which outrank this file entirely.
#
# PRECEDENCE, highest first:
#
#   1. real environment variables
#        APP_ENV=qa PORT=9000 API_PREFIX=/saarathi-service make run
#   2. backend/.env
#   3. the field defaults in app/core/settings.py
#
# The path is resolved against the backend/ directory, not the CWD, so the same
# config is found whatever directory you launch from.
#
# Every key below is a real field on Settings. extra="ignore" means a key that
# is NOT a field is silently accepted and silently does nothing, so add the
# field to app/core/settings.py first. (The Flask .env.example had accumulated
# ~12 such keys: SAARTHI_PERSISTENCE, SAARTHI_ROUTER, SAARTHI_USER_TOKEN, ...)
#
# Do NOT put an inline `# comment` after a value unless you mean it: the value
# is everything up to the comment, trailing spaces trimmed. Put comments on
# their own line, as below.

# ---- environment ---------------------------------------------------------
# A label only; it selects nothing. Echoed in the startup log so a running
# process can say which deployment it believes it is.
# development | qa | production
APP_ENV=development

# ---- server --------------------------------------------------------------
# 0.0.0.0 in a container, 127.0.0.1 locally.
HOST=127.0.0.1
PORT=8000
# MUST stay 1 while MITRA_ENABLED=1 — MitraSessionManager pools live WebSockets
# in process memory. assert_single_worker enforces it. Scale with THREADPOOL_SIZE.
WORKERS=1
# Mounted in front of EVERY route, including /healthz and /docs. The app serves
# it itself, so a proxy must FORWARD the prefix, not strip it.
API_PREFIX=

# ---- core ----------------------------------------------------------------
LOG_LEVEL=INFO
# REQUIRED. Missing => sys.exit(1) at import.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ---- database ------------------------------------------------------------
# Deliberately a DIFFERENT database from the Flask app's, so both can run side
# by side without fighting over the agents / agent_configs tables.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/saarthi_new
DB_POOL_SIZE=16
DB_MAX_OVERFLOW=8
# One request == one thread == one DB connection, so this MUST stay
# <= DB_POOL_SIZE or overload becomes 500s. Unset => DB_POOL_SIZE.
# THREADPOOL_SIZE=16

# ---- web tier ------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Must include the
# SPA's origin (frontend/.env -> APPLICATION_DEV_PORT) or CORS blocks it.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- registry ------------------------------------------------------------
# Upper bound on how long an agent config change takes to go live. The DATABASE
# IS THE ONLY SOURCE: no YAML, no CONFIG_SYNC_MODE, nothing to redeploy.
REGISTRY_TTL_S=30

# ---- identity — AUTH_CHECK is the only switch ----------------------------
# IDENTITY IS RESOLVED ONCE, FROM THIS FILE -- not per request. The SPA has no
# login flow, so every request this process serves gets the SAME UserContext.
#
# true => decode SAARTHI_STATIC_TOKEN below; the token IS the identity.
# false => the hardcoded identity in app/services/identity.py. NEVER in prod.
AUTH_CHECK=true
# The Saarthi-issued JWT. Required while AUTH_CHECK=true, and decoded once at
# startup, so a malformed token is a boot failure rather than a user-facing one.
SAARTHI_STATIC_TOKEN=

# ---- email derivation — MUST match Mitra's SSO path exactly --------------
# Mitra derives email = data[JWT_IDENTIFIER_FIELD] + JWT_EMAIL_SUFFIX. Wrong
# values create a SECOND Mitra profile and split that person's stories.
JWT_IDENTIFIER_FIELD=id
JWT_EMAIL_SUFFIX=@shikshalokam.org

# ---- feature flags -------------------------------------------------------
# 0 => the whole /api/agents admin surface 404s
SAARTHI_ADMIN_ENABLED=0
# 0 disables all remote_flow agents
MITRA_ENABLED=0

# ---- mitra ---------------------------------------------------------------
# These FOUR keys, plus MITRA_ENABLED above, are the only Mitra environment
# variables. Everything else moved into the agent config -- see below.
#
# Mitra gates admission on the Origin header — treat this as a CREDENTIAL, and
# never store it in a config row. A scope needing its OWN names it via
# `remote.origin_env`; the value stays here.
MITRA_ORIGIN_URL=https://<allowlisted-origin>
# Bounds on ONE process-wide channel pool shared by every agent, so these
# cannot be per-agent. Each open channel is a socket plus a thread.
MITRA_MAX_OPEN_CHANNELS=200
MITRA_IDLE_CLOSE_S=1200
# SSRF backstop on a config-supplied `remote.connection.allowed_hosts`, which is
# what MitraRestClient._validate_url checks presigned report URLs against.
# EMPTY MEANS NO CEILING — set it to every host a tenant may be pointed at.
# MITRA_HOST_CEILING=<report-static-host>

# ---- NOT HERE ANY MORE ---------------------------------------------------
# WHICH Mitra deployment an agent reaches is per agent and per tenant, so it is
# not configuration of this process. All of these are gone from the environment
# and nothing reads them:
#
#   MITRA_COMPANY, MITRA_STORY_BOT_ROUTE, MITRA_DISCUSSION_BOT_ROUTE
#       -> `remote.company` / `remote.bot_route`      (migration 0007)
#   MITRA_BASE_URL, MITRA_WS_URL, MITRA_USER_AGENT, MITRA_ALLOWED_HOSTS,
#   MITRA_CONNECT_TIMEOUT_S, MITRA_READ_TIMEOUT_S, MITRA_WS_CONNECT_TIMEOUT_S,
#   MITRA_IP_CITY, MITRA_IP_STATE, MITRA_IP_ZIP
#       -> `remote.connection.*`                      (migration 0009)
#   MITRA_PROFILE_PATH, MITRA_GENERATE_SESSION_PATH, MITRA_CHAT_PATH,
#   MITRA_GET_STORY_PATH, MITRA_FINALIZE_V1_PATH, MITRA_FINALIZE_V2_PATH
#       -> `remote.connection.paths.*`                (migration 0009)
#
# Change them with one call, at deployment or at tenant scope:
#
#   POST /api/agents/{key}/config?tenant_id=...&organization_id=...
#
# Mitra identifies a profile by (email, company), so that is the difference
# between every tenant sharing one Mitra profile and each having its own.
#
# UPGRADING: `make migrate` copies your current values out of this environment
# into the config rows, so run it BEFORE deleting the keys from your .env. Then
# delete them — extra="ignore" means a leftover key is accepted and silently
# does nothing. See docs/configuration.md and docs/agent-configuration.md.

# ---- cloud storage (provider-agnostic) -----------------------------------
# Voice recordings go browser -> bucket via a presigned URL, so the process
# needs these before it can serve the first /api/voice request.
#
# SWITCHING PROVIDER IS A .env CHANGE, NOT A CODE CHANGE. One name per slot,
# so what ACCOUNTNAME and SECRET mean depends on the provider:
#
#   aws | s3 | oci  -> ACCOUNTNAME = access key id, SECRET = secret access key
#                      (leave BOTH empty to use the IAM role / instance
#                       credential chain, which is preferable in production)
#   gcp             -> ACCOUNTNAME = service-account email,
#                      SECRET      = the full service-account JSON (one line)
#   local           -> neither is read; files land in LOCAL_STORAGE_DIR
CLOUD_STORAGE_PROVIDER=local
# Cloud storage identity [Azure Account Name, AWS Access Key, GCP Client Email, OCI S3 Access Key or S3 Access Key]
CLOUD_STORAGE_ACCOUNTNAME=
# Cloud storage secret — a CREDENTIAL. Never log it, never echo it.
CLOUD_STORAGE_SECRET=
# AWS/OCI: the region. GCP: THE PROJECT ID — the convention has no project slot,
# so this carries it. Required for GCP when SECRET is a bare private key rather
# than the full service-account JSON.
CLOUD_STORAGE_REGION=ap-south-1
# Cloud storage endpoint for S3 and OCI only. Set it and the aws driver also
# serves OCI Object Storage, MinIO, or any other S3-compatible target.
CLOUD_ENDPOINT=
# Cloud storage default bucket name. The bucket must allow PUT from the origins
# in FRONTEND_ORIGINS — the browser uploads to it directly, so its CORS rules
# matter as much as this app's.
CLOUD_STORAGE_BUCKETNAME=
# Cloud storage public bucket name — carried for convention-compatibility with
# the Node services. Voice recordings are private, so nothing here reads it.
PUBLIC_ASSET_BUCKETNAME=
# private | public. Changes how objects are READ and nothing else: private
# issues signed, expiring URLs; public returns the stable unsigned address.
# Uploads stay presigned on BOTH — a bucket being publicly readable is never a
# reason to accept anonymous writes.
#
# Voice recordings are user speech. On a public bucket anyone who guesses a key
# can listen, so keep this private for real users; the startup log warns when
# voice runs against a public bucket.
CLOUD_STORAGE_BUCKET_TYPE=private
# Where the `local` provider keeps files. Relative paths resolve against
# backend/, not the CWD. Dev only — there is no lifecycle expiry.
LOCAL_STORAGE_DIR=var/storage

# ---- voice (bhashini) ----------------------------------------------------
# Speech-to-text and text-to-speech via Bhashini (AI4Bharat / ULCA Dhruva), the
# same provider Mitra uses.
#
# 0 => the whole /api/voice surface answers 503 VOICE_DISABLED and the container
# builds neither the Bhashini client nor the object store.
VOICE_ENABLED=0
# Three CREDENTIALS, issued together at bhashini.gov.in. Dhruva wants different
# subsets per task: ASR sends all three, TTS and translation send
# BHASHINI_AUTHORIZATION alone.
BHASHINI_API_KEY=<ulca-api-key>
BHASHINI_USER_ID=<ulca-user-id>
BHASHINI_AUTHORIZATION=<inference-api-key>
BHASHINI_PIPELINE_ID=<ulca-pipeline-id>
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_CONNECT_TIMEOUT=10
BHASHINI_READ_TIMEOUT=30
# ~10 minutes of Opus. Checked against object metadata before the body is read,
# so an oversized upload costs a HEAD rather than a download.
VOICE_MAX_AUDIO_BYTES=10485760
# Seconds of audio per ASR request. Dhruva degrades on long clips, so a
# recording is split and the chunks are transcribed in parallel.
VOICE_CHUNK_DURATION_S=10
# Bhashini's per-request text ceiling, in UTF-8 BYTES not characters — Indic
# scripts run 3 bytes/char, so this is ~1600 Devanagari characters.
VOICE_TTS_BYTE_LIMIT=4800
# Bounds the ASR fan-out at Dhruva.
VOICE_ASR_MAX_WORKERS=4
