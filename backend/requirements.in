# scripts/verify_discussion_report.py only -- the app must never import this.
# A blank report PDF is invisible to every in-app check (Mitra returns 200 with
# a valid, empty file), so verifying it means extracting the text.
pypdf

# gunicorn is deliberately NOT here. MITRA_ENABLED=1 requires a single worker
# process (MitraSessionManager pools live WebSockets in process memory), so the
# only thing a process manager would add is a way to violate that. Run uvicorn
# directly and scale with THREADPOOL_SIZE. See app/core/runtime.py.
